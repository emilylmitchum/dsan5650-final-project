@article{board_of_governors_of_the_federal_reserve_system_us_disentangling_2019,
	title = {Disentangling the {Effects} of the 2018-2019 {Tariffs} on a {Globally} {Connected} {U}.{S}. {Manufacturing} {Sector}},
	volume = {2019},
	issn = {19362854},
	url = {http://www.federalreserve.gov/econres/feds/files/2019086pap.pdf},
	doi = {10.17016/FEDS.2019.086},
	abstract = {Since the beginning of 2018, the United States has undertaken unprecedented tariﬀ increases, with one goal of these actions being to boost the manufacturing sector. In this paper, we estimate the eﬀect of the tariﬀs—including retaliatory tariﬀs by U.S. trading partners—on manufacturing employment, output, and producer prices. A key feature of our analysis is accounting for the multiple ways that tariﬀs might aﬀect the manufacturing sector, including providing protection for domestic industries, raising costs for imported inputs, and harming competitiveness in overseas markets due to retaliatory tariﬀs. We ﬁnd that U.S. manufacturing industries more exposed to tariﬀ increases experience relative reductions in employment as a positive eﬀect from import protection is oﬀset by larger negative eﬀects from rising input costs and retaliatory tariﬀs. Higher tariﬀs are also associated with relative increases in producer prices via rising input costs.},
	language = {en},
	number = {086},
	urldate = {2020-11-25},
	journal = {Finance and Economics Discussion Series},
	author = {{Board of Governors of the Federal Reserve System (U.S.)} and Flaaen, Aaron and {Board of Governors of the Federal Reserve System (U.S.)} and Pierce, Justin},
	month = dec,
	year = {2019},
	file = {Board of Governors of the Federal Reserve System (U.S.) et al. - 2019 - Disentangling the Effects of the 2018-2019 Tariffs.pdf:files/426/Board of Governors of the Federal Reserve System (U.S.) et al. - 2019 - Disentangling the Effects of the 2018-2019 Tariffs.pdf:application/pdf},
}

