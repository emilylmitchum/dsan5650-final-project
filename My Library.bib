@article{vadakkepatt_sustainable_2021,
	series = {Re-{Strategizing} {Retailing} in a {Technology} {Based} {Era}},
	title = {Sustainable {Retailing}},
	volume = {97},
	issn = {0022-4359},
	url = {https://www.sciencedirect.com/science/article/pii/S0022435920300713},
	doi = {10.1016/j.jretai.2020.10.008},
	abstract = {As consumers seek products that cause minimal environmental harm and bring about positive social impact, and as awareness of supply chain impact grows, retailers must embrace sustainability. Given their unique position in the supply chain between upstream suppliers and downstream consumers, retailers are key to a circular economy in which products at the initial end-of-life stage are returned to the supply chain for continued use. By serving as a connection between suppliers and consumers, retail initiatives can help to reduce, reuse, and recycle. Furthermore, retailers can leverage their unique position in the supply chain to enable and legitimize a focus on social issues across the supply chain. We discuss such actions, the challenges that need to be overcome to have scalable impact, and the mechanisms retailers can utilize to make such progress.},
	language = {en},
	number = {1},
	urldate = {2021-04-28},
	journal = {Journal of Retailing},
	author = {Vadakkepatt, Gautham G. and Winterich, Karen Page and Mittal, Vikas and Zinn, Walter and Beitelspacher, Lauren and Aloysius, John and Ginger, Jessica and Reilman, Julie},
	month = mar,
	year = {2021},
	keywords = {Sustainability, Circular economy, Retailing, Social impact, Supply chain},
	pages = {62--80},
	file = {ScienceDirect Full Text PDF:files/783/Vadakkepatt et al. - 2021 - Sustainable Retailing.pdf:application/pdf;ScienceDirect Snapshot:files/784/S0022435920300713.html:text/html},
}

