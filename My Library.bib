@article{samari_first_2017,
	title = {First birth and the trajectory of women's empowerment in {Egypt}},
	volume = {17},
	issn = {1471-2393},
	doi = {10.1186/s12884-017-1494-2},
	abstract = {BACKGROUND: Women's empowerment is often used to explain changes in reproductive behavior, but no consideration is given to how reproductive events can shape women's empowerment over time. Fertility may cause changes in women's empowerment, or they may be mutually influencing. Research on women's empowerment and fertility relies on cross-sectional data from South Asia, which limits the understanding of the direction of association between women's empowerment and fertility in other global contexts. This study uses two waves of a panel survey from a prominent Middle Eastern country, Egypt, to examine the trajectory of women's empowerment and the relationship between first and subsequent births and empowerment over time.
METHODS: Using longitudinal data from the 2006 and 2012 Egyptian Labor Market Panel Survey, a nationally representative sample of households in Egypt, for 4660 married women 15 to 49 years old, multilevel negative binomial, ordinary least squares, and logistic regression models estimate women's empowerment and consider whether a first and subsequent births are associated with empowerment later in life. Women's empowerment is operationalized through four measures of agency: individual household decision-making, joint household decision-making, mobility, and financial autonomy.
RESULTS: A first birth and subsequent births are significantly positively associated with all measures of empowerment except financial autonomy in 2012. Women who have not had a birth make 30\% fewer individual household decisions and 14\% fewer joint household decisions in 2012 compared to women with a first birth. There is also a positive relationship with mobility, as women with a first birth have more freedom of movement compared to women with no births. Earlier empowerment is also an important predictor of empowerment later in life.
CONCLUSIONS: Incorporating the influence of life events like first and subsequent births helps account for the possibility that empowerment is dynamic and that life course experiences shape women's empowerment. This and the notion that empowerment builds over time helps portray women's lives more completely, demonstrates the importance of empowerment early in the life course, and addresses issues of temporality in empowerment fertility research.},
	language = {eng},
	number = {Suppl 2},
	journal = {BMC pregnancy and childbirth},
	author = {Samari, Goleen},
	month = nov,
	year = {2017},
	keywords = {Fertility, Adolescent, Adult, Birth Order, Decision Making, Egypt, Empowerment, Family Characteristics, Female, Humans, Logistic Models, Longitudinal Studies, Marriage, Middle Aged, Middle East and North Africa, Personal Autonomy, Power, Psychological, Pregnancy, Sex Factors, Women's Rights, Women’s agency, Women’s health, Young Adult},
	pages = {362},
	file = {Full Text:files/110/Samari - 2017 - First birth and the trajectory of women's empowerm.pdf:application/pdf},
}

@article{ali_impact_2018,
	title = {The {Impact} of {Female} {Education} on {Fertility}: {A} {Natural} {Experiment} from {Egypt}},
	volume = {16},
	issn = {1569-5239},
	shorttitle = {The {Impact} of {Female} {Education} on {Fertility}},
	url = {http://search.proquest.com/econlit/docview/2089840898/E996CA8809D44539PQ/4},
	doi = {http://dx.doi.org.proxyau.wrlc.org/10.1007/s11150-016-9357-6},
	abstract = {This paper presents new evidence on the impact of female education on fertility in Egypt using the change in the length of primary schooling as the source of exogenous variation in education. Beginning in 1988, the Egyptian government cut the number of primary school years from six to five, moving from a 12-year system of pre-university education to an 11-year system. This policy change affected all individuals born on or after October 1977. Using triennial pooled cross-section data from 1992 to 2014 and a nonparametric regression discontinuity approach, we compare education and fertility of women born just before and right after October 1977. Our analysis shows that female education significantly reduces the number of children born per woman. The reduction in fertility seems to result from delaying maternal age rather than changing women's fertility preferences. We also provide evidence that female education in Egypt does not boost women's labor force participation or affect their usages of contraceptive methods. Female education, however, does appear to increase women's age at marriage which might explain the delay of maternal age.},
	language = {English},
	number = {3},
	urldate = {2020-04-22},
	journal = {Review of Economics of the Household},
	author = {Ali, Fatma Romeh M. and Gurmu, Shiferaw},
	year = {2018},
	note = {Num Pages: 32},
	keywords = {Child Care, Children, Family Planning, Fertility, Youth (J13), Labor Force Participation, Egypt, Female, Africa, Contraceptive, Economic Development: Human Resources, Economics of Gender, Education, Human Capital, Human Development, Income Distribution, Labor Force, Labor Productivity (J24), Migration (O15), Non-labor Discrimination (J16), Occupational Choice, Participation, Returns to Education (I26), Schooling, Skills, Time Allocation and Labor Supply (J22), Women},
	pages = {681--712},
	file = {Full Text PDF:files/112/Ali and Gurmu - 2018 - The Impact of Female Education on Fertility A Nat.pdf:application/pdf},
}

